generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role : "SERVEUR" | "BARMAN" | "GERANT"
model Employe {
  id        Int        @id @default(autoincrement())
  nom       String
  pin       String
  role      String
  actif     Boolean    @default(true)
  commandes Commande[]
}

model Produit {
  id         Int            @id @default(autoincrement())
  nom        String
  categorie  String
  prix       Float
  actif      Boolean        @default(true)
  recette    LigneRecette[]
  lignes     LigneCommande[]
}

model Ingredient {
  id        Int             @id @default(autoincrement())
  nom       String          @unique
  unite     String // "cl", "g", "pièce"...
  quantite  Float           @default(0)
  seuil     Float           @default(0) // alerte si quantite <= seuil
  recettes  LigneRecette[]
  mouvements MouvementStock[]
}

// Quantité d'ingrédient consommée pour 1 unité de produit
model LigneRecette {
  id           Int        @id @default(autoincrement())
  produit      Produit    @relation(fields: [produitId], references: [id], onDelete: Cascade)
  produitId    Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantite     Float

  @@unique([produitId, ingredientId])
}

// statut : "EN_ATTENTE" | "EN_PREPARATION" | "PRETE" | "SERVIE" | "PAYEE" | "ANNULEE"
model Commande {
  id        Int             @id @default(autoincrement())
  table     String
  serveur   Employe         @relation(fields: [serveurId], references: [id])
  serveurId Int
  statut    String          @default("EN_ATTENTE")
  creeLe    DateTime        @default(now())
  majLe     DateTime        @updatedAt
  lignes    LigneCommande[]
}

model LigneCommande {
  id         Int      @id @default(autoincrement())
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId Int
  produit    Produit  @relation(fields: [produitId], references: [id])
  produitId  Int
  quantite   Int
  prixUnit   Float
  note       String?
}

// raison : "VENTE" | "ENTREE" | "AJUSTEMENT" | "ANNULATION"
model MouvementStock {
  id           Int        @id @default(autoincrement())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  delta        Float
  raison       String
  commandeId   Int?
  creeLe       DateTime   @default(now())
}
