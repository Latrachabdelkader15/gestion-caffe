generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Personnel ───────────────────────────

enum Role {
  SERVEUR
  BARMAN
  GERANT
}

model Employe {
  id         Int      @id @default(autoincrement())
  nom        String
  // Mot de passe (ou code PIN) haché avec scrypt. Jamais stocké en clair.
  // null = pas encore défini : l'employé ne peut pas se connecter.
  motDePasse String?
  role       Role
  telephone  String?
  actif      Boolean  @default(true)
  creeLe     DateTime @default(now())

  commandesPrises    Commande[]       @relation("CommandeServeur")
  commandesPreparees Commande[]       @relation("CommandeBarman")
  mouvements         MouvementStock[]
  livraisons         Livraison[]
  sessions           Session[]
}

// Connexion ouverte sur une tablette / un téléphone (cookie « session »)
model Session {
  id        String   @id // empreinte SHA-256 du jeton du cookie (le jeton lui-même n'est pas stocké)
  employe   Employe  @relation(fields: [employeId], references: [id], onDelete: Cascade)
  employeId Int
  creeLe    DateTime @default(now())
  expireLe  DateTime

  @@index([employeId])
}

// ─────────────────────────── Menu ───────────────────────────

model Produit {
  id        Int             @id @default(autoincrement())
  nom       String
  categorie String
  prix      Float // prix de vente
  actif     Boolean         @default(true)
  recette   LigneRecette[]
  lignes    LigneCommande[]
}

// Quantité d'ingrédient consommée pour 1 unité de produit
model LigneRecette {
  id           Int        @id @default(autoincrement())
  produit      Produit    @relation(fields: [produitId], references: [id], onDelete: Cascade)
  produitId    Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantite     Float

  @@unique([produitId, ingredientId])
}

// ─────────────────────────── Commandes ───────────────────────────

enum StatutCommande {
  EN_ATTENTE
  EN_PREPARATION
  PRETE
  SERVIE
  PAYEE
  ANNULEE
}

model Commande {
  id         Int              @id @default(autoincrement())
  table      String
  serveur    Employe          @relation("CommandeServeur", fields: [serveurId], references: [id])
  serveurId  Int
  barman     Employe?         @relation("CommandeBarman", fields: [barmanId], references: [id])
  barmanId   Int? // qui a préparé la commande
  statut     StatutCommande   @default(EN_ATTENTE)
  creeLe     DateTime         @default(now())
  majLe      DateTime         @updatedAt
  payeeLe    DateTime?
  lignes     LigneCommande[]
  mouvements MouvementStock[]

  @@index([statut])
  @@index([creeLe])
}

model LigneCommande {
  id         Int      @id @default(autoincrement())
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId Int
  produit    Produit  @relation(fields: [produitId], references: [id])
  produitId  Int
  quantite   Int
  prixUnit   Float // prix au moment de la commande
  note       String?
}

// ─────────────────────────── Stock ───────────────────────────

model Fournisseur {
  id          Int          @id @default(autoincrement())
  nom         String       @unique
  telephone   String?
  actif       Boolean      @default(true)
  ingredients Ingredient[]
  livraisons  Livraison[]
}

model Ingredient {
  id            Int              @id @default(autoincrement())
  nom           String           @unique
  unite         String // "cl", "g", "pièce"...
  quantite      Float            @default(0)
  seuil         Float            @default(0) // alerte si quantite <= seuil
  prixAchat     Float            @default(0) // coût d'achat par unité
  fournisseur   Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  fournisseurId Int?
  recettes      LigneRecette[]
  mouvements    MouvementStock[]
  livraisons    LigneLivraison[]
}

// Bon de réception de marchandise (entrée de stock)
model Livraison {
  id            Int              @id @default(autoincrement())
  fournisseur   Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  fournisseurId Int?
  employe       Employe?         @relation(fields: [employeId], references: [id])
  employeId     Int? // qui a réceptionné
  recueLe       DateTime         @default(now())
  note          String?
  lignes        LigneLivraison[]
  mouvements    MouvementStock[]
}

model LigneLivraison {
  id           Int        @id @default(autoincrement())
  livraison    Livraison  @relation(fields: [livraisonId], references: [id], onDelete: Cascade)
  livraisonId  Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantite     Float
  prixUnit     Float      @default(0)
}

enum RaisonMouvement {
  VENTE
  ENTREE
  AJUSTEMENT
  ANNULATION
  PERTE
}

// Historique de chaque variation de stock (delta négatif = sortie)
model MouvementStock {
  id           Int             @id @default(autoincrement())
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  delta        Float
  raison       RaisonMouvement
  commande     Commande?       @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  commandeId   Int?
  livraison    Livraison?      @relation(fields: [livraisonId], references: [id], onDelete: SetNull)
  livraisonId  Int?
  employe      Employe?        @relation(fields: [employeId], references: [id])
  employeId    Int?
  note         String?
  creeLe       DateTime        @default(now())

  @@index([ingredientId, creeLe])
}
